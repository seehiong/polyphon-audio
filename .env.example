# Copy to .env and adjust for whichever local servers you actually have
# running - these are machine/session state (which port a server happens
# to be on), not something worth a code edit. See README "Quickstart" for
# the full setup (audiocpp_server, llama-server) these point at.

POLYPHON_AUDIOCPP_URL=http://127.0.0.1:8091
POLYPHON_LLM_ENDPOINT=http://127.0.0.1:8082/v1
POLYPHON_LLM_MODEL=qwen3-30b-a3b
